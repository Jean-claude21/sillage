# Copy to .env for local development. Real values live in Netlify's environment variables
# (and in the local vault F:/programmation/perso/.secrets/sillage.env), never in this repository.

# Database. Empty locally: an embedded Postgres (PGlite) is created in .data/.
# On Netlify, Netlify DB (Neon) provides NETLIFY_DATABASE_URL by itself.
DATABASE_URL=

# Sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The owner account, created at the first start if missing.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password of the fictive reader afi.mensah@example.com (demo data only).
DEMO_CUSTOMER_PASSWORD=
# 1 fills an empty online database with the mockup's fictive readers and orders.
SEED_DEMO=

# Covers: Neon object storage of the database's branch (bucket "covers", private, S3-compatible).
# Endpoint: GET /projects/{id}/branches/{branch}/storage. Keys: a branch credential with
# storage:read + storage:write (its token_id is the access key id). Empty locally: files go to .data/covers.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-2
STORAGE_BUCKET=covers
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments: "simulated" (test page) until the shop's FedaPay account exists.
PAYMENT_PROVIDER=simulated
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox

# E-mails: written to the server log until a Resend key is set.
RESEND_API_KEY=
MAIL_FROM=Sillage <bonjour@sillage.example>

# Umami Cloud (no cookies). Without an id, nothing is measured.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST=https://cloud.umami.is
VITE_UMAMI_DOMAINS=

# 0 hides the "boutique en préparation" notes once the real catalogue is in.
VITE_DEMO_MODE=1
# 1 lets search engines index the shop (robots.txt).
INDEXING=
